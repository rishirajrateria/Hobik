# Public site URL (no trailing slash) — used for canonicals, sitemap, schema
NEXT_PUBLIC_SITE_URL=https://www.homeappraisaltoronto.ca
# Google Tag Manager container (handles Google Ads conversions + GA4)
NEXT_PUBLIC_GTM_ID=
# Google Search Console / Bing verification tokens
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
# Lead delivery: Resend (https://resend.com) API key + addresses
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
# Optional: also POST every lead as JSON to a webhook (Zapier, Make, CRM)
LEAD_WEBHOOK_URL=

# ── Dashboard database (Postgres) ────────────────────────────────────
# Vercel: connect a Neon database in the Storage tab; it sets DATABASE_URL for you.
# Local dev: a free Neon branch URL, or any local Postgres, e.g.
#   postgres://postgres@localhost:5432/hv
DATABASE_URL=

# Blog launch date (YYYY-MM-DD). Posts in content/blog publish N days after this
# ("day:" in each file's front matter). Defaults to the date of the first build.
BLOG_LAUNCH_DATE=

# Only this email can create the first (owner) account at /login. Recommended.
OWNER_EMAIL=
# Fill a PREVIEW database with ~60 days of clearly-labelled sample data on build.
# Never enable on the database you launch with.
SEED_DEMO=

# Optional preview/testing login, created at build time if no users exist yet.
# Change the password in Dashboard → My account, then remove these.
SEED_OWNER_EMAIL=
SEED_OWNER_PASSWORD=
