# Public site URL (no trailing slash) — used for canonicals, sitemap, schema
NEXT_PUBLIC_SITE_URL=https://www.homeappraisaltoronto.ca
# Google Tag Manager container (handles Google Ads conversions + GA4)
NEXT_PUBLIC_GTM_ID=
# Google Search Console / Bing verification tokens
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
# Lead delivery: Resend (https://resend.com) API key + addresses
RESEND_API_KEY=
LEAD_TO_EMAIL=
LEAD_FROM_EMAIL=
# Optional: also POST every lead as JSON to a webhook (Zapier, Make, CRM)
LEAD_WEBHOOK_URL=
